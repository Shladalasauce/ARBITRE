APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=arbitrage_terminal.db
PAPER_BALANCE=10000
DEMO_MODE=true
POLL_INTERVAL_SECONDS=30
MARKET_LIMIT_PER_EXCHANGE=40
MIN_NET_ROI=0.005
MIN_EXPECTED_PROFIT=1.00
MAX_CAPITAL_PER_OPPORTUNITY=1000
MAX_TOTAL_EXPOSURE=5000
MAX_BOOK_AGE_SECONDS=60
MIN_LIQUIDITY=5
MIN_MATCH_CONFIDENCE=VERIFIED
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
